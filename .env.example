KEYWORD=帽子

# 抖音「精选」商品全平台搜索 URL，保留 {keyword} 占位符。
# /jingxuan/ 路径是电商垂类页面，跟 /search/ 综合搜索是两个不同的页面。
SEARCH_URL_TEMPLATE=https://www.douyin.com/jingxuan/search/{keyword}?aid=5bdae7a6-79e3-43e1-a250-e45c3e271d6c&type=general

OUTPUT_DIR=output
USER_DATA_DIR=.user-data/douyin
HEADLESS=false
MAX_SCROLLS=8
CAPTURE_TIMEOUT_MS=30000

# 只导出最近 N 天发布的视频；0 表示不过滤发布时间。
MAX_AGE_DAYS=7

# ===== 反检测 / 人类化行为 =====
# 注意：以下配置可降低弹滑块概率，但无法 100% 绕过抖音风控。
# 建议用专用小号测试，不要并发多账号，不要长时间挂机运行。

# 自定义 User-Agent（留空使用脚本内置真实 Chrome UA）
USER_AGENT=

# 浏览器通道：默认 chrome，使用系统真实 Chrome。
# 如果本机未安装 Chrome，置空走 Playwright 自带 Chromium（反检测效果略差）。
BROWSER_CHANNEL=chrome

# 是否启用人类化滚动 / 鼠标移动 / 随机停顿。建议保持 true，调试时可临时关闭对比。
HUMAN_LIKE=true

# ===== 单视频播放数探测（独立实验入口） =====
# 也可以命令行传：npm run probe:play-count -- --aweme-id 7639981756393854137
PLAY_COUNT_AWEME_ID=
PLAY_COUNT_URL=
PLAY_COUNT_WAIT_MS=15000

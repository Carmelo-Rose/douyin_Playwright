KEYWORD=帽子

# 平台：all / douyin / xhs。默认 all，先抓抖音再抓小红书。
PLATFORM=all

# 抖音「精选」商品全平台搜索 URL，保留 {keyword} 占位符。
# /jingxuan/ 路径是电商垂类页面，跟 /search/ 综合搜索是两个不同的页面。
SEARCH_URL_TEMPLATE=https://www.douyin.com/jingxuan/search/{keyword}?aid=5bdae7a6-79e3-43e1-a250-e45c3e271d6c&type=general

OUTPUT_DIR=output
# 留空时默认使用 .user-data/<PLATFORM>，例如 .user-data/douyin 或 .user-data/xhs。
USER_DATA_DIR=
HEADLESS=false
MAX_SCROLLS=8
CAPTURE_TIMEOUT_MS=30000

# 内容形式：image=图文，video=视频。默认抓图文；需要视频时改为 video。
CONTENT_TYPE=image

# 图文详情页补图：逐条打开详情页提取多张图片。低频慢速执行，遇验证码会停止补图并保留封面。
ENRICH_DOUYIN_DETAIL_IMAGES=true
ENRICH_XHS_DETAIL_IMAGES=true
DETAIL_MAX_ITEMS=30
DETAIL_IMAGE_LIMIT=6
DETAIL_MIN_DELAY_MS=5000
DETAIL_MAX_DELAY_MS=12000

# 小红书视觉质量筛选：全量 notes 保留，额外写入视觉列和 qualified sheet。
# 缺少 DASHSCOPE_API_KEY 时会自动跳过视觉筛选，不中断抓取。
XHS_VISUAL_FILTER=true
XHS_VISUAL_MAX_IMAGES=3
XHS_VISUAL_CONCURRENCY=2
XHS_VISUAL_MAX_ITEMS=0
XHS_VISUAL_TIMEOUT_MS=90000
XHS_VISUAL_FEWSHOT=true
XHS_VISUAL_FEWSHOT_PATH=prompts/xhs-visual-fewshot.json
XHS_VISUAL_RULES_PATH=references/xhs/visual_rules.md
XHS_VISUAL_REFERENCE_IMAGES=false
XHS_VISUAL_REFERENCE_GOOD_DIR=references/xhs/good
XHS_VISUAL_REFERENCE_BAD_DIR=references/xhs/bad
XHS_VISUAL_REFERENCE_BORDERLINE_DIR=references/xhs/borderline
XHS_VISUAL_REFERENCE_MAX_IMAGES_PER_CLASS=7
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-flash

# 只导出最近 N 天发布的内容；0 表示不过滤发布时间。
MAX_AGE_DAYS=7

# 只导出标题/作者/链接中命中这些词的内容；留空时会根据 KEYWORD 自动生成基础关键词。
# 多个词用英文逗号分隔。
RELEVANCE_KEYWORDS=

# ===== 反检测 / 人类化行为 =====
# 注意：以下配置可降低弹滑块概率，但无法 100% 绕过抖音风控。
# 建议用专用小号测试，不要并发多账号，不要长时间挂机运行。

# 自定义 User-Agent（留空使用脚本内置真实 Chrome UA）
USER_AGENT=

# 浏览器通道：默认 chrome，使用系统真实 Chrome。
# 如果本机未安装 Chrome，置空走 Playwright 自带 Chromium（反检测效果略差）。
BROWSER_CHANNEL=chrome

# 是否启用人类化滚动 / 鼠标移动 / 随机停顿。建议保持 true，调试时可临时关闭对比。
HUMAN_LIKE=true

# ===== 单视频播放数探测（独立实验入口） =====
# 也可以命令行传：npm run probe:play-count -- --aweme-id 7639981756393854137
PLAY_COUNT_AWEME_ID=
PLAY_COUNT_URL=
PLAY_COUNT_WAIT_MS=15000

# ===== 小红书探针 =====
# 首次运行会使用 .user-data/xhs 保存登录态：
# npm run probe:xhs -- --keyword 帽子
# 正式采集可用：
# npm run capture -- --platform xhs --keyword 帽子

# ===== social-monitor 视觉打分（小米 MiMo，Anthropic 兼容接口）=====
# 在 .env 里填真实值；不要把 key 提交到 git。
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5

# 模型权重缓存（开源权重，可重新下载，勿入库）
cache/
# LAION 美学 predictor 权重（aesthetic.py 会自动下载，勿入库）
weights/
__pycache__/
# 从 xlsx 提取的图片与中间产物（可由脚本重新生成）
data/images/
data/embeddings.npz
# 标注图片数据集（260MB+ 二进制，太大不入库；请自行备份！）
data/labeled/
# 保留 dataset.jsonl 和 validation_result.json 作为实验记录
!data/dataset.jsonl
!data/validation_result.json
# 训练好的模型（很小，入库方便复用）
!model/
!model/aesthetic_clf.joblib
!model/train_report.json
# 预测输入/输出图片（可由脚本重新生成，二进制太大不入库）
data/to_predict/**/*.webp
data/result_*/**/*.webp
data/fp_clusters/**/*.webp
data/self_consistency/**/*.webp
